# ==========================================
# Fantasy Hockey Hub - Configuration
# ==========================================

# Secret key used for signing session cookies / JWTs (generate any secure random string)
SECRET_KEY=change-this-to-a-super-secret-random-key-32-chars

# Master Admin Password to protect your dashboard
ADMIN_PASSWORD=adminpassword123

# Path where SQLite database and tokens are stored
# In Unraid / Docker, this is mounted to /data
DATA_DIR=./data

# Yahoo Developer App Credentials (created at https://developer.yahoo.com/apps/create/)
# Redirect URI must match: http://<YOUR_IP_OR_DOMAIN>:<PORT>/auth/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://localhost:8585/auth/yahoo/callback

# Server Port and Host
HOST=0.0.0.0
PORT=8585

# Demo Mode: Set to "true" to explore the dashboard with simulated data
# Set to "false" once you connect your real Yahoo account
DEV_MOCK_DATA=true
